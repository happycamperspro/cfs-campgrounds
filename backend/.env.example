# Recreation.gov RIDB API Key (get at https://ridb.recreation.gov)
RECREATION_GOV_API_KEY=your_ridb_api_key_here

# NPS API Key (get at https://developer.nps.gov)
NPS_API_KEY=your_nps_api_key_here

# Google Places API Key (optional, for enrichment phase)
GOOGLE_PLACES_API_KEY=

# Firebase Project ID
FIREBASE_PROJECT_ID=hcp-social-chat-firebase-host

# Firebase Service Account JSON path (for local development)
# Leave empty when running in Cloud environment (uses ADC)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
